# ==========================================
# 🚀 图床服务配置文件
# ==========================================
# ⚠️ 注意：标记为 [必填] 的配置项必须填写，否则服务无法启动
#
# 🔑 密钥生成命令 (加密需要):
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# 📝 配置说明
# 1. 所有布尔值使用 true/false (小写)
# 2. 留空的配置项使用默认值
# 3. 密钥等敏感信息请妥善保管
# 4. 生产环境建议修改所有默认密钥
# ==========================================

# ------------------------------------------
# [必填] 基础配置
# ------------------------------------------
# 服务对外域名/IP，用于生成直链
HOST_DOMAIN=http://127.0.0.1:8000

# 后端监听端口 (端口被占用时修改)
APP_PORT=8000
# 管理后台监听端口
ADMIN_PORT=3000
# 监控栈端口 (仅 --monitoring 部署时使用)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# ⚠️ 修改 APP_PORT 后,请同步修改上面 HOST_DOMAIN 中的端口

# ------------------------------------------
# 🔐 鉴权配置 [可选]
# ------------------------------------------
# 是否开启 API Key 鉴权
AUTH_ENABLED=false
# 鉴权密钥 (开启鉴权时建议修改)
API_KEY=my_secret_key_123

# ------------------------------------------
# 🔒 加密配置 [可选]
# ------------------------------------------
# 是否开启文件加密 (Fernet AES-128)
# ⚠️ 开启后必须填写 ENCRYPTION_KEY
ENCRYPTION_ENABLED=false
# 加密密钥 (开启加密时必填)
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ------------------------------------------
# 🗜️ 压缩配置 [可选]
# ------------------------------------------
# 是否开启 Gzip 压缩 (推荐开启，可节省 60-80% 空间)
COMPRESSION_ENABLED=false
# 压缩等级 (1-9，越高压缩率越高但速度越慢)
COMPRESSION_LEVEL=6

# ------------------------------------------
# ☁️ OSS 云存储配置 [可选]
# ------------------------------------------
# 是否启用阿里云 OSS 存储
ENABLE_OSS=false
# OSS Endpoint (如: oss-cn-hangzhou.aliyuncs.com)
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# Bucket 名称
OSS_BUCKET=your-bucket-name
# AccessKey ID
OSS_AK=your_access_key
# AccessKey Secret
OSS_SK=your_secret_key
# OSS 公网访问域名 (如: https://bucket.oss-cn-hangzhou.aliyuncs.com)
OSS_DOMAIN=https://your-bucket.oss-cn-hangzhou.aliyuncs.com

# ------------------------------------------
# 🚦 限流配置
# ------------------------------------------
# 限流规则 (格式: 数量/时间单位)
# 示例: 60/minute (每分钟 60 次), 10/second (每秒 10 次)
RATE_LIMIT=60/minute
# Redis 地址 (留空使用内存限流，填写则使用 Redis 分布式限流)
# 格式: redis://localhost:6379/0
REDIS_URL=

# ------------------------------------------
# 🛡️ 安全配置
# ------------------------------------------
# 文件大小限制 (字节，默认 10MB = 10485760)
MAX_FILE_SIZE=10485760
# CORS 允许的来源 (逗号分隔，* 表示允许所有)
# 示例: https://example.com,https://api.example.com
CORS_ORIGINS=*

# ------------------------------------------
# 🌐 Nginx + HTTPS 配置 [可选] (由 ./deploy.sh nginx 使用)
# ------------------------------------------
# 后端/文件直链域名 (必填,纯域名,不带 http://,如 img.example.com)
# ⚠️ 配置后请将上面 HOST_DOMAIN 改为 https://<该域名> 并重新 deploy
NGINX_DOMAIN=
# 管理后台域名 (留空则不反代管理后台)
NGINX_ADMIN_DOMAIN=
# 证书申请邮箱 (留空则不注册邮箱,证书到期前无邮件提醒)
NGINX_CERT_EMAIL=
# 证书安装目录 (acme.sh --install-cert 目标,nginx 配置从此处读取)
NGINX_CERT_DIR=/etc/nginx/ssl
